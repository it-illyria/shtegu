# Formspree — create a form at formspree.io and paste the ID from the /f/<id> URL.
NEXT_PUBLIC_FORMSPREE_ID=

# Supabase — copy to .env.local and fill in from your project's API settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: needed solely to push imported trails (scripts/import-osm.mjs --push).
# NEVER expose this in client code. Keep it out of NEXT_PUBLIC_*. Do NOT set on Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: host albania.pmtiles on object storage (range requests + CORS) and
# point here to enable the vector/offline basemap in production. The CSP allows
# this origin automatically. Defaults to online OSM raster tiles if unset.
NEXT_PUBLIC_BASEMAP_PMTILES_URL=
# Set to "raster" only if the archive above holds raster tiles (ours is vector).
NEXT_PUBLIC_BASEMAP_PMTILES_KIND=
# Alternatively, a full MapLibre style JSON URL (overrides the above).
NEXT_PUBLIC_BASEMAP_STYLE_URL=

# Thunderforest — free API key for the Outdoors basemap: https://www.thunderforest.com/
NEXT_PUBLIC_THUNDERFOREST_API_KEY=

# Mapillary — access token for street-level photo overlay: https://www.mapillary.com/developer
NEXT_PUBLIC_MAPILLARY_ACCESS_TOKEN=

# Optional: build-time site-wide banner. Shown above every page until dismissed.
# For live, admin-managed alerts use the Admin panel "Alerts" tab instead.
NEXT_PUBLIC_ALERT_MESSAGE=
NEXT_PUBLIC_ALERT_MESSAGE_SQ=
# One of: info | warning | danger
NEXT_PUBLIC_ALERT_SEVERITY=

# Pinned magic-link redirect origin. MUST be the exact production URL
# to prevent malicious clones from redirecting auth tokens to themselves
# (RT2-H3). Example: https://shtegu.vercel.app/auth/callback
NEXT_PUBLIC_AUTH_REDIRECT_ORIGIN=https://shtegu.vercel.app
